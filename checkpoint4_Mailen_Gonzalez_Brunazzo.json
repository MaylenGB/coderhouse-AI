            "Problema": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Problema', `Descripción breve y clara del problema principal, en una sola oración, sin datos personales innecesarios.`, 'string') }}",
            "Categoria": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Categoria', `Una sola de estas opciones: Acceso, Facturación, Bug, Rendimiento, Consulta, Otro.`, 'string') }}",
            "Prioridad": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prioridad', `Exactamente una de estas: ALTA, MEDIA o BAJA. ALTA si el usuario no puede trabajar o hay caída total; MEDIA si hay una función afectada pero puede seguir; BAJA si es una consulta o mejora.`, 'string') }}",
            "Resumen": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Resumen', `Resumen de 1 o 2 oraciones con el contexto útil para el equipo de soporte: qué pasó, desde cuándo y qué intentó la persona.`, 'string') }}",
            "Nombre": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Nombre', `Nombre de la persona que escribió, tal como lo informó. Si no lo dijo, escribí \"No informado\". Nunca lo inventes.`, 'string') }}",
            "Empresa": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Empresa', `Empresa u organización de la persona, tal como la informó. Si no la dijo, escribí \"No informado\". Nunca la inventes.`, 'string') }}",
            "Proxima_accion": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Proxima_accion', `Acción recomendada para el equipo de soporte, en una sola oración (por ejemplo: \"Revisar logs de acceso y contactar al usuario\"). No prometas tiempos ni soluciones.`, 'string') }}"
